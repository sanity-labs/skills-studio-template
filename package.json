{
  "name": "skills-studio-template",
  "private": true,
  "description": "Template for running your own AI agent Skills Studio on Sanity",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --dir studio dev",
    "test": "pnpm -r --filter ./studio --filter ./functions exec vitest run",
    "deploy:functions": "npx sanity@latest blueprints deploy"
  },
  "devDependencies": {
    "@sanity/blueprints": "0.20.1"
  }
}
